<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<fx:root type="AnchorPane" prefHeight="700.0" prefWidth="1100.0" styleClass="lobby-screen lobby-ttt" stylesheets="@stylesheets/global.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24.0" AnchorPane.bottomAnchor="32.0" AnchorPane.leftAnchor="36.0" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="28.0">
            <children>
                <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="16.0">
                    <children>
                        <Button onAction="#handleBack" styleClass="back-button" text="←  Back" />
                        <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Label styleClass="lobby-chip" text="WAITING ROOM" />
                    </children>
                </HBox>

                <VBox spacing="6.0">
                    <children>
                        <Label fx:id="lobbyTitle" styleClass="mode-title" style="-fx-font-size: 42px;" text="Lobby" />
                        <Label fx:id="lobbySubtitle" styleClass="mode-subtitle" text="Share the code with your opponent. When both are connected, the host starts the match." wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="TOP_LEFT" spacing="28.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox maxWidth="1.7976931348623157E308" spacing="20.0" HBox.hgrow="ALWAYS" minWidth="420.0">
                            <children>
                                <VBox spacing="14.0" styleClass="lobby-card lobby-code-card">
                                    <children>
                                        <Label styleClass="lobby-card-heading" text="Lobby code" />
                                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                                            <children>
                                                <Label fx:id="lobbyCodeLabel" styleClass="lobby-code-value" text="----" />
                                                <Region maxWidth="1.7976931348623157E308" minWidth="8.0" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="copyCodeBtn" minWidth="88.0" mnemonicParsing="false" onAction="#handleCopyCode" styleClass="primary-button" text="Copy" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="0.0" styleClass="lobby-card lobby-players-card" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="playerCountLabel" styleClass="lobby-card-heading" text="Players" />

                                        <VBox spacing="0.0" styleClass="lobby-player-list">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="lobby-player-row">
                                                    <children>
                                                        <VBox alignment="CENTER" styleClass="lobby-avatar-slot" minWidth="48.0" prefWidth="48.0">
                                                            <children>
                                                                <Label styleClass="lobby-avatar-letter" text="H" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label fx:id="hostNameLabel" styleClass="lobby-player-name" text="—" />
                                                                        <Label fx:id="hostYouPill" managed="false" styleClass="lobby-you-pill" text="YOU" visible="false" />
                                                                        <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                                                        <Label fx:id="hostSlotLabel" styleClass="lobby-slot-tag" text="Host" />
                                                                    </children>
                                                                </HBox>
                                                                <Label fx:id="hostEloLabel" styleClass="lobby-elo" text="Elo —" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <Region prefHeight="1.0" maxHeight="1.0" styleClass="lobby-player-divider" />

                                                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="lobby-player-row">
                                                    <children>
                                                        <VBox alignment="CENTER" styleClass="lobby-avatar-slot lobby-avatar-guest" minWidth="48.0" prefWidth="48.0">
                                                            <children>
                                                                <Label styleClass="lobby-avatar-letter" text="G" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label fx:id="guestNameLabel" styleClass="lobby-player-name" text="—" />
                                                                        <Label fx:id="guestYouPill" managed="false" styleClass="lobby-you-pill" text="YOU" visible="false" />
                                                                        <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                                                        <Label fx:id="guestSlotLabel" styleClass="lobby-slot-tag" text="Guest" />
                                                                    </children>
                                                                </HBox>
                                                                <Label fx:id="guestEloLabel" styleClass="lobby-elo" text="Elo —" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Label fx:id="connectionHintLabel" styleClass="lobby-hint" text="Waiting for your opponent to join…" wrapText="true" />
                                    </children>
                                </VBox>

                                <Button fx:id="startGameBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleStartGame" prefHeight="52.0" styleClass="start-button" text="Start game" />
                            </children>
                        </VBox>

                        <VBox minWidth="280.0" prefWidth="300.0" maxWidth="340.0" spacing="20.0">
                            <children>
                                <VBox spacing="14.0" styleClass="lobby-card lobby-side-card">
                                    <children>
                                        <Label styleClass="lobby-card-heading" text="Match details" />
                                        <VBox spacing="10.0">
                                            <children>
                                                <HBox styleClass="lobby-kv-row">
                                                    <children>
                                                        <Label styleClass="lobby-kv-key" text="Game" />
                                                        <Label fx:id="gameNameLabel" styleClass="lobby-kv-value" text="—" />
                                                    </children>
                                                </HBox>
                                                <HBox styleClass="lobby-kv-row">
                                                    <children>
                                                        <Label styleClass="lobby-kv-key" text="Privacy" />
                                                        <Label fx:id="privacyLabel" styleClass="lobby-kv-value" text="—" />
                                                    </children>
                                                </HBox>
                                                <HBox styleClass="lobby-kv-row">
                                                    <children>
                                                        <Label styleClass="lobby-kv-key" text="Max players" />
                                                        <Label fx:id="maxPlayersLabel" styleClass="lobby-kv-value" text="2" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</fx:root>
