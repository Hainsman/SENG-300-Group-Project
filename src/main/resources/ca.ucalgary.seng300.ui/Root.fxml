<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="root" prefHeight="730.0" prefWidth="1020" stylesheets="@stylesheets/romas_stylesheet.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.CentralController">
   <children>
      <BorderPane fx:id="viewContainer" prefHeight="200.0" prefWidth="200.0">
         <top>
            <BorderPane id="title-bar" fx:id="titleBarPane" maxHeight="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" BorderPane.alignment="CENTER">
               <right>
                  <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="150.0" BorderPane.alignment="CENTER">
                     <children>
                        <Button id="minimize-maximize-button" fx:id="minimizeButton" mnemonicParsing="false" text="–" />
                        <Button id="minimize-maximize-button" fx:id="maximizeButton" mnemonicParsing="false" text="⬜" />
                        <Button id="exit-button" fx:id="quitButton" mnemonicParsing="false" text="❌" />
                     </children>
                  </HBox>
               </right>
               <center>
                  <Label id="sub-header" fx:id="titleLabel" text="Title" BorderPane.alignment="CENTER" />
               </center>
               <left>
                  <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="150.0" BorderPane.alignment="CENTER" />
               </left>
            </BorderPane>
         </top>
      </BorderPane>
   </children>
</StackPane>
