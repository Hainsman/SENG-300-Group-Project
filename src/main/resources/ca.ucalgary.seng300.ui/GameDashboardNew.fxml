<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="680.0" prefWidth="1020.0"
            stylesheets="@stylesheets/modern_theme.css"
            styleClass="app-surface"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.ucalgary.seng300.ui.GameDashboardNewController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24"
              AnchorPane.bottomAnchor="28.0"
              AnchorPane.leftAnchor="34.0"
              AnchorPane.rightAnchor="34.0"
              AnchorPane.topAnchor="34.0">

            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <children>
                    <Label text="⚡ ONLINE MULTIPLAYER" styleClass="mode-badge" />
                    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                        <children>
                            <MenuButton mnemonicParsing="false" popupSide="BOTTOM" styleClass="profile-menu-button">
                                <graphic>
                                    <StackPane styleClass="avatar-badge">
                                        <children>
                                            <Circle radius="18.0" styleClass="avatar-circle" />
                                            <Label text="IMG" styleClass="avatar-label" />
                                        </children>
                                    </StackPane>
                                </graphic>
                                <items>
                                    <MenuItem mnemonicParsing="false" onAction="#handleProfileMenuProfile" text="Profile" />
                                    <MenuItem mnemonicParsing="false" onAction="#handleProfileMenuSettings" text="Settings" />
                                    <SeparatorMenuItem />
                                    <MenuItem mnemonicParsing="false" onAction="#handleProfileMenuLogout" text="Log out" />
                                </items>
                            </MenuButton>
                        </children>
                    </HBox>
                </children>
            </HBox>
            <Label text="Choose Your Game" styleClass="mode-title" />
            <Label text="Select a game to play online with a friend" styleClass="mode-subtitle" />

            <HBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">

                <VBox onMouseClicked="#TTTclicked" prefHeight="220.0" prefWidth="360.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="✕" styleClass="mode-icon" />
                        <Label text="TIC TAC TOE" styleClass="mode-card-title" />
                        <Label text="Classic 3×3 strategy" styleClass="mode-card-subtitle" />
                        <Label text="➔ Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

                <VBox onMouseClicked="#C4click" prefHeight="220.0" prefWidth="360.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="⬤" styleClass="mode-icon" />
                        <Label text="CONNECT 4" styleClass="mode-card-title" />
                        <Label text="Drop and connect" styleClass="mode-card-subtitle" />
                        <Label text="➔ Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

            </HBox>

        </VBox>
    </children>
</AnchorPane>
