<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="680.0" prefWidth="1020.0"
            stylesheets="@stylesheets/modern_theme.css"
            styleClass="app-surface"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.ucalgary.seng300.ui.miscellaneous.ChooseModeController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24"
              AnchorPane.bottomAnchor="28.0"
              AnchorPane.leftAnchor="34.0"
              AnchorPane.rightAnchor="34.0"
              AnchorPane.topAnchor="34.0">

            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <children>
                    <Label text="&#9889; ONLINE MULTIPLAYER" styleClass="mode-badge" />
                    <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                        <children>
                            <MenuButton mnemonicParsing="false" popupSide="BOTTOM" styleClass="profile-menu-button">
                                <graphic>
                                    <StackPane styleClass="avatar-badge">
                                        <children>
                                            <Circle radius="18.0" styleClass="avatar-circle" />
                                            <Label text="IMG" styleClass="avatar-label" />
                                        </children>
                                    </StackPane>
                                </graphic>
                                <items>
                                    <MenuItem mnemonicParsing="false" onAction="#handleProfileMenuProfile" text="Profile" />
                                    <MenuItem mnemonicParsing="false" onAction="#handleProfileMenuSettings" text="Settings" />
                                    <SeparatorMenuItem />
                                    <MenuItem mnemonicParsing="false" onAction="#handleProfileMenuLogout" text="Log out" />
                                </items>
                            </MenuButton>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <Label text="Choose Option" styleClass="mode-title" />
            <Label fx:id="gameTitleLabel" styleClass="mode-subtitle" text="Pick how to play this game online" />

            <HBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
                <VBox onMouseClicked="#handleHostGame" prefHeight="280.0" prefWidth="350.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="&#128421;" styleClass="mode-icon" />
                        <Label text="HOST" styleClass="mode-card-title" />
                        <Label text="Create Lobby" styleClass="mode-card-subtitle" />
                        <Label text="&#10132; Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

                <VBox onMouseClicked="#handleJoinGame" prefHeight="280.0" prefWidth="350.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="&#127918;" styleClass="mode-icon" />
                        <Label text="JOIN" styleClass="mode-card-title" />
                        <Label text="Join Lobby" styleClass="mode-card-subtitle" />
                        <Label text="&#10132; Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

                <VBox fx:id="playWithAiCard" onMouseClicked="#handlePlayWithAi" prefHeight="280.0" prefWidth="350.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="&#129302;" styleClass="mode-icon" />
                        <Label text="PLAY WITH AI" styleClass="mode-card-title" />
                        <Label fx:id="aiOpponentLabel" text="Random opponent" styleClass="mode-card-subtitle" />
                        <Label text="&#10132; Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

                <VBox onMouseClicked="#handleOpenLeaderboard" prefHeight="280.0" prefWidth="350.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="&#127942;" styleClass="mode-icon" />
                        <Label text="LEADERBOARD" styleClass="mode-card-title" />
                        <Label text="Top players for this game" styleClass="mode-card-subtitle" />
                        <Label text="&#10132; View Rankings" styleClass="mode-play" />
                    </children>
                </VBox>
            </HBox>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label onMouseClicked="#handleBack" style="-fx-text-fill:#a1a1aa; -fx-font-size:14px; -fx-cursor:hand;" text="&#8592; Back to Menu" />
            </HBox>

        </VBox>
    </children>
</AnchorPane>
