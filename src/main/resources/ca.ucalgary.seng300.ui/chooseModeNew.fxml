<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="680.0" prefWidth="1020.0"
            stylesheets="@stylesheets/global.css"
            styleClass="app-surface"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.ucalgary.seng300.ui.ChooseModeController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24"
              AnchorPane.bottomAnchor="28.0"
              AnchorPane.leftAnchor="34.0"
              AnchorPane.rightAnchor="34.0"
              AnchorPane.topAnchor="34.0">

            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <children>
                    <Label text="⚡ ONLINE MULTIPLAYER" styleClass="mode-badge" />
                    <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                        <children>
                            <MenuButton popupSide="BOTTOM" mnemonicParsing="false" focusTraversable="false" styleClass="player-avatar-menu">
                                <graphic>
                                    <StackPane styleClass="avatar-badge">
                                        <children>
                                            <Circle radius="18.0" styleClass="avatar-circle" />
                                            <Label text="IMG" styleClass="avatar-label" />
                                        </children>
                                    </StackPane>
                                </graphic>
                                <items>
                                    <MenuItem text="Profile" onAction="#handleProfileDashboard" />
                                    <MenuItem text="Settings" onAction="#handleTeamSettings" />
                                </items>
                            </MenuButton>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <Label text="Choose Match Type" styleClass="mode-title" />
            <Label fx:id="gameTitleLabel" styleClass="mode-subtitle" text="Pick how to play this game online" />

            <HBox alignment="CENTER" spacing="16" VBox.vgrow="ALWAYS">
                <VBox onMouseClicked="#handleHostGame" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="🖥" styleClass="mode-icon" />
                        <Label text="HOST" styleClass="mode-card-title" />
                        <Label text="Create Lobby" styleClass="mode-card-subtitle" />
                        <Label text="➔ Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

                <VBox onMouseClicked="#handleJoinGame" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="🎮" styleClass="mode-icon" />
                        <Label text="JOIN" styleClass="mode-card-title" />
                        <Label text="Join Lobby" styleClass="mode-card-subtitle" />
                        <Label text="➔ Play Now" styleClass="mode-play" />
                    </children>
                </VBox>

                <VBox fx:id="playWithAiCard" onMouseClicked="#handlePlayWithAi" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="🤖" styleClass="mode-icon" />
                        <Label text="PLAY WITH AI" styleClass="mode-card-title" />
                        <Label text="Random opponent — Tic Tac Toe" styleClass="mode-card-subtitle" />
                        <Label text="➔ Play Now" styleClass="mode-play" />
                    </children>
                </VBox>
            </HBox>

            <Label onMouseClicked="#handleBack" style="-fx-text-fill:#a1a1aa; -fx-font-size:14px; -fx-cursor:hand;" text="← Back to Menu" />

        </VBox>
    </children>
</AnchorPane>
