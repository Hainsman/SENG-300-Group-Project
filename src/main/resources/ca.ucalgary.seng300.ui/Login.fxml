<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="680.0" prefWidth="1020.0" spacing="16"
      stylesheets="@styleMaster.css" styleClass="root"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ca.ucalgary.seng300.ui.LoginController">
    <padding>
        <Insets top="60" bottom="60" left="300" right="300"/>
    </padding>

    <Label text="Bogo Solutions"
           maxWidth="Infinity" alignment="CENTER"
           styleClass="header-box"
           prefHeight="70" />

    <Label text="Login"
           maxWidth="Infinity" alignment="CENTER"
           styleClass="mode-title" />

    <VBox spacing="16">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="👤" styleClass="icon-label" />
            <TextField fx:id="usernameField"
                       promptText="Username"
                       maxWidth="Infinity"
                       prefHeight="40"
                       styleClass="input-field"
                       HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="🔒" styleClass="icon-label" />
            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="Infinity"
                           prefHeight="40"
                           styleClass="input-field"
                           HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <CheckBox fx:id="rememberMeBox"
              text="Remember Me"
              styleClass="login-checkbox" />

    <Label fx:id="errorLabel"
           styleClass="error-text"
           text="" />

    <VBox spacing="14">
        <Button text="Submit"
                onAction="#handleLogin"
                prefHeight="45" maxWidth="Infinity"
                styleClass="button" />

        <Label text="New User?"
               maxWidth="Infinity" alignment="CENTER"
               styleClass="card-title" />

        <Button text="Create New Account"
                onAction="#handleNewUser"
                prefHeight="45" maxWidth="Infinity"
                styleClass="secondary-button" />

        <Button text="Forgot Password?"
                onAction="#handleForgotPassword"
                maxWidth="Infinity" alignment="CENTER"
                styleClass="link-button" />
    </VBox>

</VBox>