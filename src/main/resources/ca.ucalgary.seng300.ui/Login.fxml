<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<HBox alignment="CENTER" prefHeight="680.0" prefWidth="1020.0" spacing="34"
      stylesheets="@stylesheets/modern_theme.css" styleClass="app-surface"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ca.ucalgary.seng300.ui.login.LoginController">
    <padding><Insets top="34" bottom="34" left="34" right="34"/></padding>

    <StackPane minWidth="500.0" prefHeight="610.0" prefWidth="500.0" maxWidth="500.0">
        <children>
            <ImageView fitHeight="610.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@stylesheets/images/logo.jpg" />
                </image>
            </ImageView>
        </children>
        <clip>
            <Rectangle arcHeight="40.0" arcWidth="40.0" height="610.0" width="500.0" />
        </clip>
    </StackPane>

    <VBox alignment="CENTER" minWidth="430.0" maxWidth="430.0" prefWidth="430.0" spacing="16" styleClass="auth-form-card">
        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size:36px;" styleClass="mode-title" text="Welcome Back" />
        <Label alignment="CENTER" maxWidth="Infinity" styleClass="mode-subtitle" text="Sign in to your account" />

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="icon-label" text="👤" />
            <TextField fx:id="usernameField"
                       maxWidth="Infinity"
                       prefHeight="40"
                       promptText="Email or Username"
                       styleClass="input-field"
                       HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="icon-label" text="🔒" />
            <PasswordField fx:id="passwordField"
                           maxWidth="Infinity"
                           prefHeight="40"
                           promptText="Password"
                           styleClass="input-field"
                           HBox.hgrow="ALWAYS" />
        </HBox>
        <Label fx:id="errorLabel" styleClass="error-text" text="" />
        <VBox spacing="12">
            <Button maxWidth="Infinity"
                    fx:id="loginButton"
                    onAction="#handleLogin"
                    prefHeight="45"
                    styleClass="auth-outline-button"
                    text="Sign In" />
            <Button maxWidth="Infinity"
                    fx:id="newUserButton"
                    onAction="#handleNewUser"
                    prefHeight="45"
                    styleClass="auth-outline-button"
                    text="Create New Account" />
            <Button alignment="CENTER"
                    fx:id="forgotPasswordButton"
                    maxWidth="Infinity"
                    onAction="#handleForgotPassword"
                    styleClass="link-button"
                    text="Forgot Password?" />
        </VBox>
    </VBox>

</HBox>
