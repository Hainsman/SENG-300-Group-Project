<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<fx:root type="AnchorPane" prefHeight="680.0" prefWidth="1020.0"
            stylesheets="@stylesheets/global.css"
            styleClass="app-surface"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24"
              AnchorPane.bottomAnchor="28.0"
              AnchorPane.leftAnchor="34.0"
              AnchorPane.rightAnchor="34.0"
              AnchorPane.topAnchor="34.0">

            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <children>
                    <Label text="⚡ ONLINE MULTIPLAYER" styleClass="mode-badge" />
                    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                        <children>
                            <MenuButton popupSide="BOTTOM" mnemonicParsing="false" focusTraversable="false" styleClass="player-avatar-menu">
                                <graphic>
                                    <StackPane styleClass="avatar-badge">
                                        <children>
                                            <Circle radius="18.0" styleClass="avatar-circle" />
                                            <Label text="IMG" styleClass="avatar-label" />
                                        </children>
                                    </StackPane>
                                </graphic>
                                <items>
                                    <MenuItem text="Profile" onAction="#handleProfileDashboard" />
                                    <MenuItem text="Settings" onAction="#handleTeamSettings" />
                                    <SeparatorMenuItem />
                                    <MenuItem text="Log out" onAction="#handleLogout" />
                                </items>
                            </MenuButton>
                        </children>
                    </HBox>
                </children>
            </HBox>
            <Label text="Choose Your Game" styleClass="mode-title" />
            <Label text="Select a game to play online with a friend" styleClass="mode-subtitle" />

            <HBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">

                <VBox fx:id="tttCard" onMouseClicked="#TTTclicked" focusTraversable="true"
                      prefHeight="220.0" prefWidth="360.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="✕" styleClass="mode-icon" focusTraversable="false" />
                        <Label text="TIC TAC TOE" styleClass="mode-card-title" focusTraversable="false" />
                        <Label text="Classic 3×3 strategy" styleClass="mode-card-subtitle" focusTraversable="false" />
                        <Label text="➔ Play Now" styleClass="mode-play" focusTraversable="false" />
                    </children>
                </VBox>

                <VBox fx:id="c4Card" onMouseClicked="#C4click" focusTraversable="true"
                      prefHeight="220.0" prefWidth="360.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label text="⬤" styleClass="mode-icon" focusTraversable="false" />
                        <Label text="CONNECT 4" styleClass="mode-card-title" focusTraversable="false" />
                        <Label text="Drop and connect" styleClass="mode-card-subtitle" focusTraversable="false" />
                        <Label text="➔ Play Now" styleClass="mode-play" focusTraversable="false" />
                    </children>
                </VBox>

            </HBox>

        </VBox>
    </children>
</fx:root>
