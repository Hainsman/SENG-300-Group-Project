<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<fx:root prefHeight="680.0" prefWidth="1020.0" styleClass="app-surface" stylesheets="@stylesheets/global.css" type="AnchorPane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24" AnchorPane.bottomAnchor="28.0" AnchorPane.leftAnchor="34.0" AnchorPane.rightAnchor="34.0" AnchorPane.topAnchor="34.0">

            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                <children>
                    <Label styleClass="mode-badge" text="⚡ ONLINE MULTIPLAYER" />
                    <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                        <children>
                     <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@stylesheets/images/bogo_solutions_logo.png" />
                        </image>
                     </ImageView>
                            <MenuButton focusTraversable="false" mnemonicParsing="false" popupSide="BOTTOM" styleClass="player-avatar-menu">
                                <graphic>
                                    <StackPane styleClass="avatar-badge">
                                        <children>
                                            <Circle radius="18.0" styleClass="avatar-circle" />
                                            <Label styleClass="avatar-label" text="IMG" />
                                        </children>
                                    </StackPane>
                                </graphic>
                                <items>
                                    <MenuItem onAction="#handleProfileDashboard" text="Profile" />
                                    <MenuItem onAction="#handleTeamSettings" text="Settings" />
                                </items>
                            </MenuButton>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <Label styleClass="mode-title" text="Choose Match Type" />
            <Label fx:id="gameTitleLabel" styleClass="mode-subtitle" text="Pick how to play this game online" />

            <HBox alignment="CENTER" spacing="16" VBox.vgrow="ALWAYS">
                <VBox onMouseClicked="#handleHostGame" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label styleClass="mode-icon" text="🖥" />
                        <Label styleClass="mode-card-title" text="HOST" />
                        <Label styleClass="mode-card-subtitle" text="Create Lobby" />
                        <Label styleClass="mode-play" text="➔ Play Now" />
                    </children>
                </VBox>

                <VBox onMouseClicked="#handleJoinGame" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label styleClass="mode-icon" text="🎮" />
                        <Label styleClass="mode-card-title" text="JOIN" />
                        <Label styleClass="mode-card-subtitle" text="Join Lobby" />
                        <Label styleClass="mode-play" text="➔ Play Now" />
                    </children>
                </VBox>

                <VBox fx:id="playWithAiCard" onMouseClicked="#handlePlayWithAi" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="mode-card">
                    <children>
                        <Label styleClass="mode-icon" text="🤖" />
                        <Label styleClass="mode-card-title" text="PLAY WITH AI" />
                        <Label styleClass="mode-card-subtitle" text="Random opponent — Tic Tac Toe" />
                        <Label styleClass="mode-play" text="➔ Play Now" />
                    </children>
                </VBox>
            </HBox>

            <Label onMouseClicked="#handleBack" style="-fx-text-fill:#a1a1aa; -fx-font-size:14px; -fx-cursor:hand;" text="← Back to Menu" />

        </VBox>
    </children>
</fx:root>
