<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="680.0" prefWidth="1020.0" spacing="16"
      stylesheets="@styleMaster.css" styleClass="root"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ca.ucalgary.seng300.ui.NewUserController">
    <padding>
        <Insets top="60" bottom="60" left="300" right="300"/>
    </padding>

    <Label text="Bogo Solutions"
           maxWidth="Infinity" alignment="CENTER"
           styleClass="header-box"
           prefHeight="70" />

    <Label text="Create New Account"
           maxWidth="Infinity" alignment="CENTER"
           styleClass="mode-title" />

    <VBox spacing="16">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="👤" styleClass="icon-label" />
            <TextField fx:id="usernameField"
                       promptText="Username"
                       maxWidth="Infinity"
                       prefHeight="40"
                       styleClass="input-field"
                       HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="📧" styleClass="icon-label" />
            <TextField fx:id="emailField"
                       promptText="Email"
                       maxWidth="Infinity"
                       prefHeight="40"
                       styleClass="input-field"
                       HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="🔒" styleClass="icon-label" />
            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="Infinity"
                           prefHeight="40"
                           styleClass="input-field"
                           HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="🔒" styleClass="icon-label" />
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm Password"
                           maxWidth="Infinity"
                           prefHeight="40"
                           styleClass="input-field"
                           HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <Label fx:id="errorLabel"
           styleClass="error-text"
           text="" />

    <VBox spacing="14">
        <Button text="Create Account"
                onAction="#handleCreateAccount"
                prefHeight="45" maxWidth="Infinity"
                styleClass="button" />

        <Button text="Back to Login"
                onAction="#handleBack"
                prefHeight="45" maxWidth="Infinity"
                styleClass="secondary-button" />
    </VBox>

</VBox>