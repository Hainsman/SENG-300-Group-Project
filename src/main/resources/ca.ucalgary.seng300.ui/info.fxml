<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400" prefWidth="600" stylesheets="@stylesheets/global.css" styleClass="app-surface" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.InfoController">

    <!-- Top Label showing the game name -->
    <top>
        <Label fx:id="gameTitleLabel" text="Game Name"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-padding: 20;
                      -fx-text-fill: white;
                      -fx-background-radius: 10;
                      -fx-background-insets: 0;
                      -fx-background-color: #27244a;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 4, 0, 2, 2);"
               BorderPane.alignment="CENTER" />
    </top>

    <!-- Center area showing the rules -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <TextArea fx:id="rulesTextArea" editable="false" prefHeight="250" prefWidth="500"
                      style="-fx-font-size: 16px;
                             -fx-padding: 10;
                             -fx-background-color: #1f1b3a;
                             -fx-text-fill: #f2f2f2;
                             -fx-border-color: #4b3f72;
                             -fx-border-width: 4;
                             -fx-background-radius: 10;
                             -fx-border-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 4, 0, 2, 2);"
                      text="Rules will appear here." wrapText="true" />
        </VBox>
    </center>

    <!-- Bottom Back Button -->
    <bottom>
        <Button fx:id="backButton" onAction="#handleBack" text="Back"
                style="-fx-font-size: 16px;
                       -fx-padding: 10 20 10 20;
                       -fx-background-radius: 10;
                       -fx-background-insets: 0;
                       -fx-background-color: #3b2a61;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 4, 0, 2, 2);"
                BorderPane.alignment="CENTER" />
    </bottom>

</BorderPane>