<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="boardPane" alignment="TOP_CENTER" prefHeight="680.0" prefWidth="1240.0" stylesheets="@stylesheets/modern_theme.css" styleClass="app-surface" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.Connect4Controller">
    <children>
        <HBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 18 18 18 18;">
            <VBox minWidth="250.0" prefWidth="250.0" spacing="16" styleClass="chat-shell">
                <children>
                    <Label text="Bogo Solutions" styleClass="mode-card-title" style="-fx-font-size: 28px;" />
                    <Label fx:id="sidebarGameTitleLabel" styleClass="mode-title" style="-fx-font-size: 26px; -fx-text-fill: #60a5fa;" text="Connect 4" />
                    <Label fx:id="profileNameLabel" styleClass="card-title" text="Player" />
                    <Label fx:id="profileEmailLabel" styleClass="mode-subtitle" wrapText="true" text="player@example.com" />
                    <VBox spacing="12" styleClass="ttt-shell" style="-fx-padding: 18 20;">
                        <children>
                            <HBox spacing="12">
                                <children>
                                    <Label text="Elo" styleClass="card-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="eloValueLabel" styleClass="mode-subtitle" text="0" />
                                </children>
                            </HBox>
                            <HBox spacing="12">
                                <children>
                                    <Label text="Tier" styleClass="card-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="tierValueLabel" styleClass="mode-subtitle" text="Bronze" />
                                </children>
                            </HBox>
                            <HBox spacing="12">
                                <children>
                                    <Label text="Games" styleClass="card-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="gamesPlayedValueLabel" styleClass="mode-subtitle" text="0" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Button fx:id="forfeitButton" onAction="#handleForfeit" prefHeight="42.0" prefWidth="220.0" styleClass="back-button" text="✕  Forfeit" />
                    <Button fx:id="infoButton" onAction="#handleInfo" prefHeight="42.0" prefWidth="220.0" styleClass="back-button" text="ⓘ  Info" />
                    <Button fx:id="exitButton" onAction="#handleExit" prefHeight="42.0" prefWidth="220.0" styleClass="back-button" text="✕  Exit" />
                </children>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="16" style="-fx-padding: 12 8 12 8;">
                <children>
                    <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                        <children>
                            <Label text="&#9889; ONLINE MULTIPLAYER" styleClass="mode-badge" />
                        </children>
                    </HBox>

                    <Label style="-fx-font-size: 34px;" styleClass="mode-title" text="Connect 4" />
                    <Label fx:id="statusLabel" style="-fx-font-size:18px;" styleClass="mode-subtitle" text="Player 1's Turn" />

                    <VBox alignment="CENTER" spacing="12" style="-fx-padding: 12 14;" styleClass="ttt-shell">
                        <children>
                            <GridPane fx:id="gridPane" alignment="CENTER" hgap="8" styleClass="c4-grid" vgap="8" />
                            <Button fx:id="backButton" onAction="#handleBackToMode" prefHeight="42.0" prefWidth="148.0" styleClass="back-button" text="Back" />
                            <Button fx:id="resetButton" onAction="#resetClick" prefHeight="42.0" prefWidth="148.0" styleClass="primary-button" text="Rematch" visible="false" />
                        </children>
                    </VBox>
                </children>
            </VBox>

            <VBox alignment="TOP_CENTER" maxWidth="320.0" minWidth="320.0" prefWidth="320.0" spacing="8" styleClass="chat-shell">
                <children>
                    <Label styleClass="card-title" text="Match Chat" />
                    <ListView fx:id="chatList" maxHeight="520.0" minHeight="520.0" prefHeight="520.0" prefWidth="296.0" styleClass="chat-list" VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="8">
                        <children>
                            <TextField fx:id="chatInput" onAction="#handleSendChat" prefWidth="194.0" promptText="Type a message..." />
                            <Button fx:id="sendChatButton" onAction="#handleSendChat" prefHeight="36.0" prefWidth="92.0" styleClass="primary-button" text="Send" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </HBox>
    </children>
</StackPane>
