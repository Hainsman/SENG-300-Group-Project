<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@lobbyStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.joinLobbyController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" styleClass="header-box">
                <Label fx:id="gameTitleLabel" styleClass="title-label" text="Game Title" />
                <Label prefHeight="18.0" prefWidth="79.0" styleClass="subtitle-label" text=" Join a Game " />
            </VBox>

            <HBox spacing="20">

                <!-- LEFT SIDE -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <!-- Enter Code -->
                    <VBox spacing="10" styleClass="card">
                        <Label styleClass="card-title" text="Enter Lobby Code" />

                        <HBox spacing="10">
                            <TextField fx:id="codeField" promptText="Enter 6-digit code..." HBox.hgrow="ALWAYS" />
                            <Button fx:id="joinByCodeBtn"  text="Join" />
                        </HBox>
                    </VBox>

                    <!-- Search -->
                    <VBox styleClass="card">
                        <TextField fx:id="searchField" promptText="Search by host name or game..." />
                    </VBox>

                    <!-- Available Lobbies -->
                    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
                        <Label styleClass="card-title" text="Available Lobbies" />

                        <ListView fx:id="lobbyList" VBox.vgrow="ALWAYS" />
                    </VBox>

                </VBox>

                <!-- RIGHT SIDE -->
                <VBox prefWidth="250" spacing="20">

                    <VBox styleClass="card">
                        <Label styleClass="card-title" text="Quick Join" />
                        <Label text="Ask your friend for their lobby code and enter it above." wrapText="true" />
                    </VBox>

                    <VBox styleClass="card">
                        <Label styleClass="card-title" text="How to Join" />
                        <Label text="1. Get a code&#10;2. Enter it&#10;3. Wait for host" wrapText="true" />
                    </VBox>

                    <VBox styleClass="card">
                        <Label styleClass="card-title" text="Active Now" />
                        <Label text="Players Online: 1234" />
                        <Label text="Active Lobbies: 42" />
                    </VBox>

                </VBox>

            </HBox>

            <Button onAction="#handleBack" styleClass="back-button" text="← Back to Menu" />

        </VBox>
    </children>

</AnchorPane>
