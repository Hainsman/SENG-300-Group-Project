<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root" prefHeight="220.0" prefWidth="440.0"
           stylesheets="@stylesheets/popup.css,@stylesheets/global.css"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ca.ucalgary.seng300.ui.Popup">
    <children>
        <BorderPane styleClass="popup-surface">
            <top>
                <BorderPane id="popup-title-bar" fx:id="titleBarPane"
                            maxHeight="-Infinity" minHeight="-Infinity"
                            prefHeight="36.0" BorderPane.alignment="CENTER">
                    <right>
                        <HBox maxHeight="-Infinity" maxWidth="-Infinity"
                              prefHeight="36.0" prefWidth="36.0"
                              BorderPane.alignment="CENTER" />
                    </right>
                    <center>
                        <Label id="popup-title-label" fx:id="titleLabel"
                               text="Notice" BorderPane.alignment="CENTER" />
                    </center>
                    <left>
                        <HBox maxHeight="-Infinity" maxWidth="-Infinity"
                              prefHeight="36.0" prefWidth="36.0"
                              BorderPane.alignment="CENTER" />
                    </left>
                </BorderPane>
            </top>
            <center>
                <VBox styleClass="popup-body" alignment="CENTER">
                    <children>
                        <Label fx:id="iconLabel" styleClass="popup-icon" text="" />
                        <Label fx:id="messageLabel" styleClass="popup-message"
                               wrapText="true" maxWidth="380.0" />
                        <HBox styleClass="popup-button-row" alignment="CENTER">
                            <children>
                                <Button fx:id="okButton" styleClass="popup-ok-button"
                                        text="OK" mnemonicParsing="false" />
                                <Button fx:id="cancelButton" styleClass="popup-cancel-button"
                                        text="Cancel" mnemonicParsing="false"
                                        visible="false" managed="false" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</StackPane>
