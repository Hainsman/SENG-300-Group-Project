<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.ucalgary.seng300.ui.mainMenuController"
            prefWidth="900.0" prefHeight="600.0" >

    <children>
        <VBox alignment="TOP_CENTER" spacing="25"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- Title -->
            <Label text="Multiplayer Games"
                   styleClass="title-label"/>

            <Label text="Choose your game mode"
                   styleClass="subtitle-label"/>

            <!-- Cards Row -->
            <HBox spacing="40" alignment="CENTER">

                <!-- Host Game Card -->
                <VBox alignment="CENTER" spacing="10"
                      prefWidth="250" prefHeight="180"
                      styleClass="card host-card">

                    <Label text="🎮" styleClass="icon"/>
                    <Label text="Host Game" styleClass="card-title"/>
                    <Label text="Create a new lobby and invite friends"
                           wrapText="true"
                           styleClass="card-subtitle"/>
                </VBox>

                <!-- Join Game Card -->
                <VBox alignment="CENTER" spacing="10"
                      prefWidth="250" prefHeight="180"
                      styleClass="card join-card">

                    <Label text="👥" styleClass="icon"/>
                    <Label text="Join Game" styleClass="card-title"/>
                    <Label text="Connect to an existing lobby"
                           wrapText="true"
                           styleClass="card-subtitle"/>
                </VBox>

            </HBox>

            <!-- Available Games -->
            <Label text="Available Games"
                   styleClass="subtitle-label"/>

            <HBox spacing="30" alignment="CENTER">

                <Button text="Checkers"
                        prefWidth="200" prefHeight="50"
                        styleClass="btn-checkers"/>

                <Button text="Connect 4"
                        prefWidth="200" prefHeight="50"
                        styleClass="btn-connect"/>

            </HBox>

        </VBox>
    </children>

</AnchorPane>