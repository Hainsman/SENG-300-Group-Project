<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<fx:root prefHeight="680.0" prefWidth="1020.0" styleClass="game-gui-root" stylesheets="@stylesheets/global.css" type="VBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <SplitPane dividerPositions="0.3, 0.75" VBox.vgrow="ALWAYS">
      <items>

        <AnchorPane styleClass="sidebar">
          <children>
            <Label alignment="CENTER" layoutX="17.0" layoutY="14.0" prefHeight="100.0" prefWidth="270.0" styleClass="header-box" text="Bogo Solutions" textAlignment="CENTER" wrapText="true" />

            <Label fx:id="tttLabel" layoutX="68.0" layoutY="143.0" styleClass="game-title, ttt-title" text="TIC TAC TOE">
              <effect>
                <DropShadow><color><Color red="0.31" green="0.88" blue="0.85" /></color></DropShadow>
              </effect>
            </Label>

            <VBox layoutX="25.0" layoutY="209.0" prefHeight="220.0" prefWidth="250.0" styleClass="card">
              <children>
                <AnchorPane prefHeight="200.0">
                  <children>
                    <Label layoutX="15.0" layoutY="15.0" styleClass="card-title" text="Elo:" />
                    <Label fx:id="eloValue" layoutX="100.0" layoutY="15.0" styleClass="card-value" text="—" />
                    <Label layoutX="15.0" layoutY="50.0" styleClass="card-title" text="Rank:" />
                    <Label fx:id="rankValue" layoutX="100.0" layoutY="50.0" styleClass="card-value" text="—" />
                    <Label layoutX="15.0" layoutY="85.0" styleClass="card-title" text="Win:" />
                    <Label fx:id="winValue" layoutX="100.0" layoutY="85.0" styleClass="card-value" text="—" />
                  </children>
                </AnchorPane>
              </children>
            </VBox>

            <VBox layoutX="27.0" layoutY="470.0" prefWidth="250.0" spacing="12">
              <children>
                <Button maxWidth="Infinity" onAction="#handleForfeit" text="✕  Forfeit" />
                <Button fx:id="infoButton" maxWidth="Infinity" onAction="#handleInfoButton" text="ⓘ  Info" />
                        <Button fx:id="exit" layoutX="10.0" layoutY="66.0" maxWidth="Infinity" onAction="#handleExitButton" text="➜]  Exit" />
              </children>
            </VBox>
          </children>
        </AnchorPane>

        <AnchorPane styleClass="game-pane">
          <children>
            <VBox fx:id="gameBox" alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
          </children>
        </AnchorPane>

        <AnchorPane minWidth="240.0" styleClass="history-sidebar">
          <children>
            <Label alignment="CENTER" contentDisplay="CENTER" layoutX="20.0" layoutY="14.0" prefHeight="50.0" prefWidth="220.0" styleClass="match-history-header" text="Match History" />
            <ScrollPane hbarPolicy="NEVER" layoutX="20.0" layoutY="64.0" prefHeight="238.0" prefWidth="220.0" styleClass="history-scroll">
              <content>
                <VBox fx:id="historyBox" alignment="CENTER" prefHeight="239.0" prefWidth="198.0" styleClass="history-box" />
              </content>
            </ScrollPane>
             <HBox alignment="CENTER" layoutX="8.0" layoutY="377.0" spacing="8" />
            <TextField fx:id="chatInput" layoutX="20.0" layoutY="590.0" prefHeight="26.0" prefWidth="200.0" promptText="Type a message..." />
            <Button fx:id="chatSend" layoutX="91.0" layoutY="620.0" onAction="#handleChatSend" prefHeight="34.0" prefWidth="77.0" styleClass="primary-button" text="Send" />
             <Label alignment="CENTER" contentDisplay="CENTER" layoutX="17.0" layoutY="302.0" prefHeight="50.0" prefWidth="220.0" styleClass="match-history-header" text="Match Chat" />
                  <ScrollPane hbarPolicy="NEVER" layoutX="17.0" layoutY="352.0" prefHeight="238.0" prefWidth="220.0" styleClass="history-scroll">
                     <content>
                        <VBox fx:id="matchChat" prefHeight="239.0" prefWidth="198.0" styleClass="history-box" />
                     </content>
                  </ScrollPane>
          </children>
        </AnchorPane>

      </items>
    </SplitPane>
  </children>
</fx:root>
